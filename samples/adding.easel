easel 1
row on # ADDING. press PLAY, then tap the box with the right answer.
row on score = 0
row on 
row on # the question. no random numbers anywhere: sin of a big multiple of a
row on # whole number wanders without ever settling into a pattern, and floor
row on # makes it whole. So the same game replays exactly.
row on a = 1 + floor(5*abs(sin(37*(score+1))))
row on b = 1 + floor(5*abs(sin(53*(score+1))))
row on 
row on digits(a, -3.0, 1.6, 0.9)
row on digits(b, 0.4, 1.6, 0.9)
row on color(0x46525E)
row on line(-1.9 + 1.6i, -1.1 + 1.6i)
row on line(-1.5 + 1.2i, -1.5 + 2.0i)
row on line(1.4 + 1.4i, 2.2 + 1.4i)
row on line(1.4 + 1.8i, 2.2 + 1.8i)
row on 
row on # the three answers: one too few, the right one, one too many
row on digits(a + b - 1, -3.4, -2.2, 0.8)
row on digits(a + b, 0, -2.2, 0.8)
row on digits(a + b + 1, 3.4, -2.2, 0.8)
row on 
row on # the score, up in the corner
row on digits(score, 5.0, 3.2, 0.55)
row on 
row on # saying well done, and saying oh dear.
row on #
row on # `cheer` and `boo` are the moment it happened. A face is drawn at a
row on # size, so a size of nothing is a face that is not there -- and
row on # max(0, 1 - (time - cheer)) grows one on the instant and shrinks it
row on # away over a second. There is no notion of visibility anywhere.
row on cheer = -9
row on boo = -9
row on smiley(3.4, 1.5, max(0, 1.0 - 1.4*(time - cheer)))
row on ghost(3.4, 1.5, max(0, 1.0 - 0.9*(time - boo)))
row on 
row on # and the rules. the middle box is the right one.
row on #
row on # each one puts the OTHER face into the past, or a fading smile hangs
row on # about inside the ghost that follows it.
row on when tap 1: score = score - 1, boo = time, cheer = -9
row on when tap 2: score = score + 1, cheer = time, boo = -9
row on when tap 3: score = score - 1, boo = time, cheer = -9
row on A = 7.8200
row off 
mark round 0.1000 taper 0.0000 colour E0704A fill closed
