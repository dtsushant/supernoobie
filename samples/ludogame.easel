easel 1
row on # LUDO, four players, one screen. tap the DIE, then tap a token.
row on ludo()
row on 
row on # --- HOUSE RULES ------------------------------------------------
row on # Set these before you start. Each is a plain number, so each gets a
row on # slider -- a house rule is a dial, and two tables differ by a file.
row on #
row on # what brings a token out of the yard
row on opens = 6
row on # ...and whether a one does as well
row on alsoone = 0
row on # must a seat have cut somebody before it may go home?
row on mustcut = 0
row on # what earns another turn: a six, a capture, getting one home
row on again6 = 1
row on againcut = 0
row on againhome = 0
row on # may you land on a square where two of one seat already stand?
row on blockade = 1
row on # show the eight safe squares
row on stars = 1
row on 
row on # --- the state -------------------------------------------------
row on seed = 137
row on rolls = 0
row on rolled = 0
row on # when the die was last thrown. the whole throw is a function of the
row on # clock and this one number, so nothing is stepped frame by frame.
row on flung = -99
row on turn = 0
row on seat0 = 0
row on at0 = -1
row on seat1 = 0
row on at1 = -2
row on seat2 = 0
row on at2 = -3
row on seat3 = 0
row on at3 = -4
row on seat4 = 1
row on at4 = -1
row on seat5 = 1
row on at5 = -2
row on seat6 = 1
row on at6 = -3
row on seat7 = 1
row on at7 = -4
row on seat8 = 2
row on at8 = -1
row on seat9 = 2
row on at9 = -2
row on seat10 = 2
row on at10 = -3
row on seat11 = 2
row on at11 = -4
row on seat12 = 3
row on at12 = -1
row on seat13 = 3
row on at13 = -2
row on seat14 = 3
row on at14 = -3
row on seat15 = 3
row on at15 = -4
row on cuts0 = 0
row on cuts1 = 0
row on cuts2 = 0
row on cuts3 = 0
row on 
row on # --- walking, rather than teleporting ---------------------------
row on # A token that goes from square 10 to square 14 has TELEPORTED. What
row on # it should do is walk, and walking needs two more numbers: where it
row on # set off from, and when.
row on #
row on # Then where it is drawn is a function of the clock, like everything
row on # else here -- no stepping, no frame counter, and a move that can be
row on # scrubbed backwards and looks the same.
row on pace = 7
row on from0 = at0
row on moved0 = -99
row on from1 = at1
row on moved1 = -99
row on from2 = at2
row on moved2 = -99
row on from3 = at3
row on moved3 = -99
row on from4 = at4
row on moved4 = -99
row on from5 = at5
row on moved5 = -99
row on from6 = at6
row on moved6 = -99
row on from7 = at7
row on moved7 = -99
row on from8 = at8
row on moved8 = -99
row on from9 = at9
row on moved9 = -99
row on from10 = at10
row on moved10 = -99
row on from11 = at11
row on moved11 = -99
row on from12 = at12
row on moved12 = -99
row on from13 = at13
row on moved13 = -99
row on from14 = at14
row on moved14 = -99
row on from15 = at15
row on moved15 = -99
row on 
row on # how far along it has got. `min` is what stops it: it walks at `pace`
row on # squares a second and simply stops when it arrives, so no rule has to
row on # notice that it has.
row on #
row on # A token sent home does not walk -- `at` goes negative and the min
row on # takes it at once, which is right: it was carried, not walked.
row on walk0 = min(at0, from0 + pace*max(0, time - moved0))
row on walk1 = min(at1, from1 + pace*max(0, time - moved1))
row on walk2 = min(at2, from2 + pace*max(0, time - moved2))
row on walk3 = min(at3, from3 + pace*max(0, time - moved3))
row on walk4 = min(at4, from4 + pace*max(0, time - moved4))
row on walk5 = min(at5, from5 + pace*max(0, time - moved5))
row on walk6 = min(at6, from6 + pace*max(0, time - moved6))
row on walk7 = min(at7, from7 + pace*max(0, time - moved7))
row on walk8 = min(at8, from8 + pace*max(0, time - moved8))
row on walk9 = min(at9, from9 + pace*max(0, time - moved9))
row on walk10 = min(at10, from10 + pace*max(0, time - moved10))
row on walk11 = min(at11, from11 + pace*max(0, time - moved11))
row on walk12 = min(at12, from12 + pace*max(0, time - moved12))
row on walk13 = min(at13, from13 + pace*max(0, time - moved13))
row on walk14 = min(at14, from14 + pace*max(0, time - moved14))
row on walk15 = min(at15, from15 + pace*max(0, time - moved15))
row on 
row on # where each token counts as standing. the yard and the home column
row on # get numbers no other token can hold, so nobody can be caught there.
row on sq0 = if(at0 < 0, -100 - 0, if(at0 > 50, 200 + 10*seat0 + at0, mod(13*seat0 + at0, 52)))
row on sq1 = if(at1 < 0, -100 - 1, if(at1 > 50, 200 + 10*seat1 + at1, mod(13*seat1 + at1, 52)))
row on sq2 = if(at2 < 0, -100 - 2, if(at2 > 50, 200 + 10*seat2 + at2, mod(13*seat2 + at2, 52)))
row on sq3 = if(at3 < 0, -100 - 3, if(at3 > 50, 200 + 10*seat3 + at3, mod(13*seat3 + at3, 52)))
row on sq4 = if(at4 < 0, -100 - 4, if(at4 > 50, 200 + 10*seat4 + at4, mod(13*seat4 + at4, 52)))
row on sq5 = if(at5 < 0, -100 - 5, if(at5 > 50, 200 + 10*seat5 + at5, mod(13*seat5 + at5, 52)))
row on sq6 = if(at6 < 0, -100 - 6, if(at6 > 50, 200 + 10*seat6 + at6, mod(13*seat6 + at6, 52)))
row on sq7 = if(at7 < 0, -100 - 7, if(at7 > 50, 200 + 10*seat7 + at7, mod(13*seat7 + at7, 52)))
row on sq8 = if(at8 < 0, -100 - 8, if(at8 > 50, 200 + 10*seat8 + at8, mod(13*seat8 + at8, 52)))
row on sq9 = if(at9 < 0, -100 - 9, if(at9 > 50, 200 + 10*seat9 + at9, mod(13*seat9 + at9, 52)))
row on sq10 = if(at10 < 0, -100 - 10, if(at10 > 50, 200 + 10*seat10 + at10, mod(13*seat10 + at10, 52)))
row on sq11 = if(at11 < 0, -100 - 11, if(at11 > 50, 200 + 10*seat11 + at11, mod(13*seat11 + at11, 52)))
row on sq12 = if(at12 < 0, -100 - 12, if(at12 > 50, 200 + 10*seat12 + at12, mod(13*seat12 + at12, 52)))
row on sq13 = if(at13 < 0, -100 - 13, if(at13 > 50, 200 + 10*seat13 + at13, mod(13*seat13 + at13, 52)))
row on sq14 = if(at14 < 0, -100 - 14, if(at14 > 50, 200 + 10*seat14 + at14, mod(13*seat14 + at14, 52)))
row on sq15 = if(at15 < 0, -100 - 15, if(at15 > 50, 200 + 10*seat15 + at15, mod(13*seat15 + at15, 52)))
row on 
row on # --- the die, thrown across the board ---------------------------
row on #
row on # Five rows, because the throw itself lives in `plotkit::dice` where
row on # any game can have one. All five take the same four things -- the
row on # seed, which throw this is, how long ago it left the hand, and how
row on # big the board is -- so they differ only in the name at the front.
row on #
row on # It slides with its speed dying away, so the distance it covers
row on # approaches a limit and never passes it; it folds off the walls,
row on # which IS the reflection, at the angle it struck; and it turns more
row on # slowly as it goes, landing square on a right angle.
row on span = 6.4
row on age = max(0, time - flung)
row on die = dieface(seed, rolls, age, span)
row on settled = diedone(seed, rolls, age, span)
row on 
row on # --- what you can see ------------------------------------------
row on # The die itself is a MARK, further down, so it can be tapped -- this
row on # is only its face, which has to be redrawn every frame because it
row on # changes, and a mark's points do not.
row on dice(die, diex(seed, rolls, age, span), diey(seed, rolls, age, span), 0.78, dieturn(seed, rolls, age, span), diesquash(seed, rolls, age, span),          dienext(seed, rolls, age, span))
row on 
row on # whose turn it is, in that seat's own colour, in the middle of the
row on # board where the four home paths meet.
row on color(pick(turn, 0xE0704A, 0x6FCF97, 0x4FBCD4, 0xE0A44A))
row on param(0.62*exp(i*t) + 8.6 + 1.5i, 0, tau)
row on digits(turn + 1, 8.6, 1.5, 0.42)
row on 
row on # a ring that shrinks onto the die as it settles, so it is plain that
row on # the number is not yet the number. it follows the die about.
row on color(0x46525E)
row on param(if(settled, 0, 1.2)*exp(i*t) + diex(seed, rolls, age, span) + i*diey(seed, rolls, age, span), 0, tau)
row on # --- throwing it ------------------------------------------------
row on # `flung` is WHEN, so everything above is a function of the clock and
row on # nothing has to be stepped frame by frame.
row on when tap 17: rolls = rolls + if(rolled == 1, 0, 1), flung = if(rolled == 1, flung, time), rolled = 1
row on 
row on # how many of ONE seat stand on each square a token might land on.
row on # A blockade is two of a colour together; you may not land there.
row on 
row on # --- may it move? ----------------------------------------------
row on # Named once and used three times: to allow the move, to ring the
row on # tokens you may tap, and to notice that you may tap none of them.
row on # Three copies of a rule is three chances for them to disagree.
row on land0 = mod(13*seat0 + at0 + die, 52)
row on onto0 = if(blockade == 0, 0, or(or(or(or(or(or(or(or(or(or(or(or(or(or(or(or(or(or(0, and(sq4 == sq5, sq4 == land0)), and(sq4 == sq6, sq4 == land0)), and(sq4 == sq7, sq4 == land0)), and(sq5 == sq6, sq5 == land0)), and(sq5 == sq7, sq5 == land0)), and(sq6 == sq7, sq6 == land0)), and(sq8 == sq9, sq8 == land0)), and(sq8 == sq10, sq8 == land0)), and(sq8 == sq11, sq8 == land0)), and(sq9 == sq10, sq9 == land0)), and(sq9 == sq11, sq9 == land0)), and(sq10 == sq11, sq10 == land0)), and(sq12 == sq13, sq12 == land0)), and(sq12 == sq14, sq12 == land0)), and(sq12 == sq15, sq12 == land0)), and(sq13 == sq14, sq13 == land0)), and(sq13 == sq15, sq13 == land0)), and(sq14 == sq15, sq14 == land0)))
row on can0 = and(and(and(seat0 == turn, rolled == 1), settled), if(at0 < 0, or(die == opens, and(alsoone == 1, die == 1)), and(and(at0 + die <= 57, not(onto0)), or(or(mustcut == 0, cuts[seat0] > 0), at0 + die <= 50))))
row on land1 = mod(13*seat1 + at1 + die, 52)
row on onto1 = if(blockade == 0, 0, or(or(or(or(or(or(or(or(or(or(or(or(or(or(or(or(or(or(0, and(sq4 == sq5, sq4 == land1)), and(sq4 == sq6, sq4 == land1)), and(sq4 == sq7, sq4 == land1)), and(sq5 == sq6, sq5 == land1)), and(sq5 == sq7, sq5 == land1)), and(sq6 == sq7, sq6 == land1)), and(sq8 == sq9, sq8 == land1)), and(sq8 == sq10, sq8 == land1)), and(sq8 == sq11, sq8 == land1)), and(sq9 == sq10, sq9 == land1)), and(sq9 == sq11, sq9 == land1)), and(sq10 == sq11, sq10 == land1)), and(sq12 == sq13, sq12 == land1)), and(sq12 == sq14, sq12 == land1)), and(sq12 == sq15, sq12 == land1)), and(sq13 == sq14, sq13 == land1)), and(sq13 == sq15, sq13 == land1)), and(sq14 == sq15, sq14 == land1)))
row on can1 = and(and(and(seat1 == turn, rolled == 1), settled), if(at1 < 0, or(die == opens, and(alsoone == 1, die == 1)), and(and(at1 + die <= 57, not(onto1)), or(or(mustcut == 0, cuts[seat1] > 0), at1 + die <= 50))))
row on land2 = mod(13*seat2 + at2 + die, 52)
row on onto2 = if(blockade == 0, 0, or(or(or(or(or(or(or(or(or(or(or(or(or(or(or(or(or(or(0, and(sq4 == sq5, sq4 == land2)), and(sq4 == sq6, sq4 == land2)), and(sq4 == sq7, sq4 == land2)), and(sq5 == sq6, sq5 == land2)), and(sq5 == sq7, sq5 == land2)), and(sq6 == sq7, sq6 == land2)), and(sq8 == sq9, sq8 == land2)), and(sq8 == sq10, sq8 == land2)), and(sq8 == sq11, sq8 == land2)), and(sq9 == sq10, sq9 == land2)), and(sq9 == sq11, sq9 == land2)), and(sq10 == sq11, sq10 == land2)), and(sq12 == sq13, sq12 == land2)), and(sq12 == sq14, sq12 == land2)), and(sq12 == sq15, sq12 == land2)), and(sq13 == sq14, sq13 == land2)), and(sq13 == sq15, sq13 == land2)), and(sq14 == sq15, sq14 == land2)))
row on can2 = and(and(and(seat2 == turn, rolled == 1), settled), if(at2 < 0, or(die == opens, and(alsoone == 1, die == 1)), and(and(at2 + die <= 57, not(onto2)), or(or(mustcut == 0, cuts[seat2] > 0), at2 + die <= 50))))
row on land3 = mod(13*seat3 + at3 + die, 52)
row on onto3 = if(blockade == 0, 0, or(or(or(or(or(or(or(or(or(or(or(or(or(or(or(or(or(or(0, and(sq4 == sq5, sq4 == land3)), and(sq4 == sq6, sq4 == land3)), and(sq4 == sq7, sq4 == land3)), and(sq5 == sq6, sq5 == land3)), and(sq5 == sq7, sq5 == land3)), and(sq6 == sq7, sq6 == land3)), and(sq8 == sq9, sq8 == land3)), and(sq8 == sq10, sq8 == land3)), and(sq8 == sq11, sq8 == land3)), and(sq9 == sq10, sq9 == land3)), and(sq9 == sq11, sq9 == land3)), and(sq10 == sq11, sq10 == land3)), and(sq12 == sq13, sq12 == land3)), and(sq12 == sq14, sq12 == land3)), and(sq12 == sq15, sq12 == land3)), and(sq13 == sq14, sq13 == land3)), and(sq13 == sq15, sq13 == land3)), and(sq14 == sq15, sq14 == land3)))
row on can3 = and(and(and(seat3 == turn, rolled == 1), settled), if(at3 < 0, or(die == opens, and(alsoone == 1, die == 1)), and(and(at3 + die <= 57, not(onto3)), or(or(mustcut == 0, cuts[seat3] > 0), at3 + die <= 50))))
row on land4 = mod(13*seat4 + at4 + die, 52)
row on onto4 = if(blockade == 0, 0, or(or(or(or(or(or(or(or(or(or(or(or(or(or(or(or(or(or(0, and(sq0 == sq1, sq0 == land4)), and(sq0 == sq2, sq0 == land4)), and(sq0 == sq3, sq0 == land4)), and(sq1 == sq2, sq1 == land4)), and(sq1 == sq3, sq1 == land4)), and(sq2 == sq3, sq2 == land4)), and(sq8 == sq9, sq8 == land4)), and(sq8 == sq10, sq8 == land4)), and(sq8 == sq11, sq8 == land4)), and(sq9 == sq10, sq9 == land4)), and(sq9 == sq11, sq9 == land4)), and(sq10 == sq11, sq10 == land4)), and(sq12 == sq13, sq12 == land4)), and(sq12 == sq14, sq12 == land4)), and(sq12 == sq15, sq12 == land4)), and(sq13 == sq14, sq13 == land4)), and(sq13 == sq15, sq13 == land4)), and(sq14 == sq15, sq14 == land4)))
row on can4 = and(and(and(seat4 == turn, rolled == 1), settled), if(at4 < 0, or(die == opens, and(alsoone == 1, die == 1)), and(and(at4 + die <= 57, not(onto4)), or(or(mustcut == 0, cuts[seat4] > 0), at4 + die <= 50))))
row on land5 = mod(13*seat5 + at5 + die, 52)
row on onto5 = if(blockade == 0, 0, or(or(or(or(or(or(or(or(or(or(or(or(or(or(or(or(or(or(0, and(sq0 == sq1, sq0 == land5)), and(sq0 == sq2, sq0 == land5)), and(sq0 == sq3, sq0 == land5)), and(sq1 == sq2, sq1 == land5)), and(sq1 == sq3, sq1 == land5)), and(sq2 == sq3, sq2 == land5)), and(sq8 == sq9, sq8 == land5)), and(sq8 == sq10, sq8 == land5)), and(sq8 == sq11, sq8 == land5)), and(sq9 == sq10, sq9 == land5)), and(sq9 == sq11, sq9 == land5)), and(sq10 == sq11, sq10 == land5)), and(sq12 == sq13, sq12 == land5)), and(sq12 == sq14, sq12 == land5)), and(sq12 == sq15, sq12 == land5)), and(sq13 == sq14, sq13 == land5)), and(sq13 == sq15, sq13 == land5)), and(sq14 == sq15, sq14 == land5)))
row on can5 = and(and(and(seat5 == turn, rolled == 1), settled), if(at5 < 0, or(die == opens, and(alsoone == 1, die == 1)), and(and(at5 + die <= 57, not(onto5)), or(or(mustcut == 0, cuts[seat5] > 0), at5 + die <= 50))))
row on land6 = mod(13*seat6 + at6 + die, 52)
row on onto6 = if(blockade == 0, 0, or(or(or(or(or(or(or(or(or(or(or(or(or(or(or(or(or(or(0, and(sq0 == sq1, sq0 == land6)), and(sq0 == sq2, sq0 == land6)), and(sq0 == sq3, sq0 == land6)), and(sq1 == sq2, sq1 == land6)), and(sq1 == sq3, sq1 == land6)), and(sq2 == sq3, sq2 == land6)), and(sq8 == sq9, sq8 == land6)), and(sq8 == sq10, sq8 == land6)), and(sq8 == sq11, sq8 == land6)), and(sq9 == sq10, sq9 == land6)), and(sq9 == sq11, sq9 == land6)), and(sq10 == sq11, sq10 == land6)), and(sq12 == sq13, sq12 == land6)), and(sq12 == sq14, sq12 == land6)), and(sq12 == sq15, sq12 == land6)), and(sq13 == sq14, sq13 == land6)), and(sq13 == sq15, sq13 == land6)), and(sq14 == sq15, sq14 == land6)))
row on can6 = and(and(and(seat6 == turn, rolled == 1), settled), if(at6 < 0, or(die == opens, and(alsoone == 1, die == 1)), and(and(at6 + die <= 57, not(onto6)), or(or(mustcut == 0, cuts[seat6] > 0), at6 + die <= 50))))
row on land7 = mod(13*seat7 + at7 + die, 52)
row on onto7 = if(blockade == 0, 0, or(or(or(or(or(or(or(or(or(or(or(or(or(or(or(or(or(or(0, and(sq0 == sq1, sq0 == land7)), and(sq0 == sq2, sq0 == land7)), and(sq0 == sq3, sq0 == land7)), and(sq1 == sq2, sq1 == land7)), and(sq1 == sq3, sq1 == land7)), and(sq2 == sq3, sq2 == land7)), and(sq8 == sq9, sq8 == land7)), and(sq8 == sq10, sq8 == land7)), and(sq8 == sq11, sq8 == land7)), and(sq9 == sq10, sq9 == land7)), and(sq9 == sq11, sq9 == land7)), and(sq10 == sq11, sq10 == land7)), and(sq12 == sq13, sq12 == land7)), and(sq12 == sq14, sq12 == land7)), and(sq12 == sq15, sq12 == land7)), and(sq13 == sq14, sq13 == land7)), and(sq13 == sq15, sq13 == land7)), and(sq14 == sq15, sq14 == land7)))
row on can7 = and(and(and(seat7 == turn, rolled == 1), settled), if(at7 < 0, or(die == opens, and(alsoone == 1, die == 1)), and(and(at7 + die <= 57, not(onto7)), or(or(mustcut == 0, cuts[seat7] > 0), at7 + die <= 50))))
row on land8 = mod(13*seat8 + at8 + die, 52)
row on onto8 = if(blockade == 0, 0, or(or(or(or(or(or(or(or(or(or(or(or(or(or(or(or(or(or(0, and(sq0 == sq1, sq0 == land8)), and(sq0 == sq2, sq0 == land8)), and(sq0 == sq3, sq0 == land8)), and(sq1 == sq2, sq1 == land8)), and(sq1 == sq3, sq1 == land8)), and(sq2 == sq3, sq2 == land8)), and(sq4 == sq5, sq4 == land8)), and(sq4 == sq6, sq4 == land8)), and(sq4 == sq7, sq4 == land8)), and(sq5 == sq6, sq5 == land8)), and(sq5 == sq7, sq5 == land8)), and(sq6 == sq7, sq6 == land8)), and(sq12 == sq13, sq12 == land8)), and(sq12 == sq14, sq12 == land8)), and(sq12 == sq15, sq12 == land8)), and(sq13 == sq14, sq13 == land8)), and(sq13 == sq15, sq13 == land8)), and(sq14 == sq15, sq14 == land8)))
