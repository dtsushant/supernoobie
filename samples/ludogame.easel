row on 
row on # --- a turn nobody can play -------------------------------------
row on # Roll a three with both tokens in the yard and nothing is legal. The
row on # turn has to pass by itself, or the game simply stops -- which it did.
row on when and(and(rolled == 1, settled), not(anycan)): turn = mod(turn + 1, 4), rolled = 0, passed = passed + 1
row on passed = 0
row on 
row on # --- three sixes forfeit ----------------------------------------
row on # The face is not known until the die stops, so this waits for that
row on # rather than firing when it is thrown.
row on sixes = 0
row on when and(rolled == 1, settled): sixes = if(die == 6, sixes + 1, 0)
row on when sixes > 2: turn = mod(turn + 1, 4), rolled = 0, sixes = 0
row on 
row on # --- moving a token ---------------------------------------------
