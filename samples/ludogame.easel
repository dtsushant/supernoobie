row on when tap 7: ok = and(and(and(seat6 == turn, rolled == 1), settled), if(at6 < 0, die == 6, at6 + die <= 57)), was = at6, at[6] = if(ok, if(at6 < 0, 0, at6 + die), at6), here = if(ok, if(was < 0, mod(13*seat6, 52), if(at[6] > 50, 200 + 10*seat6 + at[6], mod(13*seat6 + at[6], 52))), -999), at[0] = if(and(and(seat0 != seat6, sq0 == here), and(here >= 0, here < 52)), -1, at0), at[1] = if(and(and(seat1 != seat6, sq1 == here), and(here >= 0, here < 52)), -2, at1), at[2] = if(and(and(seat2 != seat6, sq2 == here), and(here >= 0, here < 52)), -1, at2), at[3] = if(and(and(seat3 != seat6, sq3 == here), and(here >= 0, here < 52)), -2, at3), at[4] = if(and(and(seat4 != seat6, sq4 == here), and(here >= 0, here < 52)), -1, at4), at[5] = if(and(and(seat5 != seat6, sq5 == here), and(here >= 0, here < 52)), -2, at5), at[7] = if(and(and(seat7 != seat6, sq7 == here), and(here >= 0, here < 52)), -2, at7), turn = if(ok, if(die == 6, turn, mod(turn + 1, 4)), turn), rolled = if(ok, 0, rolled)
row on when tap 8: ok = and(and(and(seat7 == turn, rolled == 1), settled), if(at7 < 0, die == 6, at7 + die <= 57)), was = at7, at[7] = if(ok, if(at7 < 0, 0, at7 + die), at7), here = if(ok, if(was < 0, mod(13*seat7, 52), if(at[7] > 50, 200 + 10*seat7 + at[7], mod(13*seat7 + at[7], 52))), -999), at[0] = if(and(and(seat0 != seat7, sq0 == here), and(here >= 0, here < 52)), -1, at0), at[1] = if(and(and(seat1 != seat7, sq1 == here), and(here >= 0, here < 52)), -2, at1), at[2] = if(and(and(seat2 != seat7, sq2 == here), and(here >= 0, here < 52)), -1, at2), at[3] = if(and(and(seat3 != seat7, sq3 == here), and(here >= 0, here < 52)), -2, at3), at[4] = if(and(and(seat4 != seat7, sq4 == here), and(here >= 0, here < 52)), -1, at4), at[5] = if(and(and(seat5 != seat7, sq5 == here), and(here >= 0, here < 52)), -2, at5), at[6] = if(and(and(seat6 != seat7, sq6 == here), and(here >= 0, here < 52)), -1, at6), turn = if(ok, if(die == 6, turn, mod(turn + 1, 4)), turn), rolled = if(ok, 0, rolled)
row on 
row on # --- winning ----------------------------------------------------
row on when and(at0 == 57, at1 == 57): won = 1
row on when and(at2 == 57, at3 == 57): won = 2
row on when and(at4 == 57, at5 == 57): won = 3
row on when and(at6 == 57, at7 == 57): won = 4
row on won = 0
row on color(0x6FCF97)
row on digits(won, 8.6, -1.2, 0.5)
mark round 0.1000 taper 0.1200 colour E0704A fill closed
group 1
placex ludox(seat0, at0)
placey ludoy(seat0, at0)
