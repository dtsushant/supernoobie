row on 
row on # a ring round each token you may move. drawn at no size when you may
row on # not, which is how a thing is hidden here.
row on color(0xE3E9EF)
row on param(if(can0, 0.52, 0)*exp(i*t) + ludox(seat0, walk0) + i*ludoy(seat0, walk0), 0, tau)
row on param(if(can1, 0.52, 0)*exp(i*t) + ludox(seat1, walk1) + i*ludoy(seat1, walk1), 0, tau)
