row on 
row on # --- the safe stars ---------------------------------------------
row on # Drawn at no size when the house does not use them, which is how a
row on # thing is hidden here.
row on # A star, because that is what a safe square is called. The four
row on # starts are in each seat's own colour -- they are that seat's square,
row on # and drawing them all in grey was why they looked misplaced rather
row on # than looking like starts.
row on color(0xE0704A)
row on star(ludox(0, 0), ludoy(0, 0), if(stars == 1, 0.34, 0), 5)
row on color(0x8A97A5)
row on star(ludox(0, 8), ludoy(0, 8), if(stars == 1, 0.3, 0), 5)
row on color(0x6FCF97)
row on star(ludox(1, 0), ludoy(1, 0), if(stars == 1, 0.34, 0), 5)
row on color(0x8A97A5)
row on star(ludox(1, 8), ludoy(1, 8), if(stars == 1, 0.3, 0), 5)
row on color(0x4FBCD4)
row on star(ludox(2, 0), ludoy(2, 0), if(stars == 1, 0.34, 0), 5)
row on color(0x8A97A5)
row on star(ludox(2, 8), ludoy(2, 8), if(stars == 1, 0.3, 0), 5)
row on color(0xE0A44A)
row on star(ludox(3, 0), ludoy(3, 0), if(stars == 1, 0.34, 0), 5)
row on color(0x8A97A5)
row on star(ludox(3, 8), ludoy(3, 8), if(stars == 1, 0.3, 0), 5)
row on 
row on # --- how many are in --------------------------------------------
row on home0 = (at0 == 57) + (at1 == 57) + (at2 == 57) + (at3 == 57)
row on color(0xE0704A)
row on digits(home0, -8.4, 4, 0.4)
row on home1 = (at4 == 57) + (at5 == 57) + (at6 == 57) + (at7 == 57)
row on color(0x6FCF97)
row on digits(home1, -8.4, 2.9, 0.4)
row on home2 = (at8 == 57) + (at9 == 57) + (at10 == 57) + (at11 == 57)
row on color(0x4FBCD4)
row on digits(home2, -8.4, 1.7999999999999998, 0.4)
row on home3 = (at12 == 57) + (at13 == 57) + (at14 == 57) + (at15 == 57)
row on color(0xE0A44A)
row on digits(home3, -8.4, 0.6999999999999997, 0.4)
row on 
row on # --- winning ----------------------------------------------------
row on when and(at0 == 57, at1 == 57): won = 1
row on when and(at4 == 57, at5 == 57): won = 2
row on when and(at8 == 57, at9 == 57): won = 3
row on when and(at12 == 57, at13 == 57): won = 4
row on won = 0
row on color(0x6FCF97)
row on digits(won, 8.6, -1.2, 0.5)
mark round 0.1000 taper 0.1200 colour E0704A fill closed
group 1
placex ludox(seat0, walk0)
placey ludoy(seat0, walk0)
