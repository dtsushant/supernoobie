row on land9 = mod(13*seat9 + at9 + die, 52)
row on onto9 = if(blockade == 0, 0, or(or(or(or(or(or(or(or(or(or(or(or(or(or(or(or(or(or(0, and(sq0 == sq1, sq0 == land9)), and(sq0 == sq2, sq0 == land9)), and(sq0 == sq3, sq0 == land9)), and(sq1 == sq2, sq1 == land9)), and(sq1 == sq3, sq1 == land9)), and(sq2 == sq3, sq2 == land9)), and(sq4 == sq5, sq4 == land9)), and(sq4 == sq6, sq4 == land9)), and(sq4 == sq7, sq4 == land9)), and(sq5 == sq6, sq5 == land9)), and(sq5 == sq7, sq5 == land9)), and(sq6 == sq7, sq6 == land9)), and(sq12 == sq13, sq12 == land9)), and(sq12 == sq14, sq12 == land9)), and(sq12 == sq15, sq12 == land9)), and(sq13 == sq14, sq13 == land9)), and(sq13 == sq15, sq13 == land9)), and(sq14 == sq15, sq14 == land9)))
