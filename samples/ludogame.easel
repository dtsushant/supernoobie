easel 1
row on # LUDO, four players, one screen. tap the DIE, then tap a token.
row on ludo()
row on 
row on # --- the state -------------------------------------------------
row on seed = 137
row on rolls = 0
row on rolled = 0
row on # when the die was last thrown. the whole throw is a function of the
row on # clock and this one number, so nothing is stepped frame by frame.
row on flung = -99
row on turn = 0
row on seat0 = 0
row on at0 = -1
row on seat1 = 0
row on at1 = -2
row on seat2 = 1
row on at2 = -1
row on seat3 = 1
row on at3 = -2
row on seat4 = 2
row on at4 = -1
row on seat5 = 2
row on at5 = -2
row on seat6 = 3
row on at6 = -1
row on seat7 = 3
row on at7 = -2
row on 
row on # where each token counts as standing. the yard and the home column
row on # get numbers no other token can hold, so nobody can be caught there.
row on sq0 = if(at0 < 0, -100 - 0, if(at0 > 50, 200 + 10*seat0 + at0, mod(13*seat0 + at0, 52)))
row on sq1 = if(at1 < 0, -100 - 1, if(at1 > 50, 200 + 10*seat1 + at1, mod(13*seat1 + at1, 52)))
row on sq2 = if(at2 < 0, -100 - 2, if(at2 > 50, 200 + 10*seat2 + at2, mod(13*seat2 + at2, 52)))
row on sq3 = if(at3 < 0, -100 - 3, if(at3 > 50, 200 + 10*seat3 + at3, mod(13*seat3 + at3, 52)))
row on sq4 = if(at4 < 0, -100 - 4, if(at4 > 50, 200 + 10*seat4 + at4, mod(13*seat4 + at4, 52)))
row on sq5 = if(at5 < 0, -100 - 5, if(at5 > 50, 200 + 10*seat5 + at5, mod(13*seat5 + at5, 52)))
row on sq6 = if(at6 < 0, -100 - 6, if(at6 > 50, 200 + 10*seat6 + at6, mod(13*seat6 + at6, 52)))
row on sq7 = if(at7 < 0, -100 - 7, if(at7 > 50, 200 + 10*seat7 + at7, mod(13*seat7 + at7, 52)))
row on 
row on # --- the die, thrown -------------------------------------------
row on #
row on # A die is flung, tumbles fast, slows, and settles. All three are one
row on # number: exp(-age/relax), which is 1 at the throw and nothing when it
row on # is over -- the same e^(-t/tau) as a branch settling after a gust or a
row on # note dying away. Laplace, doing the only thing it ever does.
row on relax = 0.42
row on age = max(0, time - flung)
row on slow = exp(-0 - age/relax)
row on 
row on # how hard it was thrown. different every roll, and worked out rather
row on # than drawn from anywhere, so the same match replays exactly.
row on spin = 11 + mod(floor(seed + 29*rolls), 13)
row on 
row on # faces turned through so far. the RATE decays, so it whirls, eases
row on # and stops -- it does not run at one speed and then halt.
row on tumbles = spin*(1 - slow)
row on 
row on # four time constants is 98 percent of the way there, which is the
row on # usual answer to `when has an exponential finished`.
row on settled = age > 4*relax
row on die = if(settled, 1 + mod(floor(spin), 6), 1 + mod(floor(tumbles), 6))
row on 
row on # and it slides, and bounces off the walls of its box. a reflection is
row on # a triangle wave: go a distance, fold it back at each edge.
row on box = 1.15
row on slid = 5.5*(1 - slow)
row on dx = box - abs(mod(slid, 2*box) - box)
row on dy = 0.55*box - abs(mod(1.7*slid, 1.1*box) - 0.55*box)
row on 
row on # --- what you can see ------------------------------------------
row on color(0xE3E9EF)
row on digits(die, 8.6 - box + dx, 4.2 - 0.3 + dy, 0.9)
row on 
row on # whose turn it is, in that seat's own colour, beside the die.
row on color(pick(turn, 0xE0704A, 0x6FCF97, 0x4FBCD4, 0xE0A44A))
row on param(0.62*exp(i*t) + 8.6 + 1.5i, 0, tau)
row on digits(turn + 1, 8.6, 1.5, 0.42)
row on 
row on # a ring round the die while it is still going, so it is plain that
row on # the number is not yet the number.
row on color(0x46525E)
row on param(if(settled, 0, 1.5)*exp(i*t) + 8.6 + 4.2i, 0, tau)
row on 
row on # --- throwing it ------------------------------------------------
row on # `flung` is WHEN, so everything above is a function of the clock and
row on # nothing has to be stepped frame by frame.
row on when tap 9: rolls = rolls + if(rolled == 1, 0, 1), flung = if(rolled == 1, flung, time), rolled = 1
row on 
row on # --- moving a token ---------------------------------------------
row on when tap 1: ok = and(and(and(seat0 == turn, rolled == 1), settled), if(at0 < 0, die == 6, at0 + die <= 57)), was = at0, at[0] = if(ok, if(at0 < 0, 0, at0 + die), at0), here = if(ok, if(was < 0, mod(13*seat0, 52), if(at[0] > 50, 200 + 10*seat0 + at[0], mod(13*seat0 + at[0], 52))), -999), at[1] = if(and(and(seat1 != seat0, sq1 == here), and(here >= 0, here < 52)), -2, at1), at[2] = if(and(and(seat2 != seat0, sq2 == here), and(here >= 0, here < 52)), -1, at2), at[3] = if(and(and(seat3 != seat0, sq3 == here), and(here >= 0, here < 52)), -2, at3), at[4] = if(and(and(seat4 != seat0, sq4 == here), and(here >= 0, here < 52)), -1, at4), at[5] = if(and(and(seat5 != seat0, sq5 == here), and(here >= 0, here < 52)), -2, at5), at[6] = if(and(and(seat6 != seat0, sq6 == here), and(here >= 0, here < 52)), -1, at6), at[7] = if(and(and(seat7 != seat0, sq7 == here), and(here >= 0, here < 52)), -2, at7), turn = if(ok, if(die == 6, turn, mod(turn + 1, 4)), turn), rolled = if(ok, 0, rolled)
row on when tap 2: ok = and(and(and(seat1 == turn, rolled == 1), settled), if(at1 < 0, die == 6, at1 + die <= 57)), was = at1, at[1] = if(ok, if(at1 < 0, 0, at1 + die), at1), here = if(ok, if(was < 0, mod(13*seat1, 52), if(at[1] > 50, 200 + 10*seat1 + at[1], mod(13*seat1 + at[1], 52))), -999), at[0] = if(and(and(seat0 != seat1, sq0 == here), and(here >= 0, here < 52)), -1, at0), at[2] = if(and(and(seat2 != seat1, sq2 == here), and(here >= 0, here < 52)), -1, at2), at[3] = if(and(and(seat3 != seat1, sq3 == here), and(here >= 0, here < 52)), -2, at3), at[4] = if(and(and(seat4 != seat1, sq4 == here), and(here >= 0, here < 52)), -1, at4), at[5] = if(and(and(seat5 != seat1, sq5 == here), and(here >= 0, here < 52)), -2, at5), at[6] = if(and(and(seat6 != seat1, sq6 == here), and(here >= 0, here < 52)), -1, at6), at[7] = if(and(and(seat7 != seat1, sq7 == here), and(here >= 0, here < 52)), -2, at7), turn = if(ok, if(die == 6, turn, mod(turn + 1, 4)), turn), rolled = if(ok, 0, rolled)
row on when tap 3: ok = and(and(and(seat2 == turn, rolled == 1), settled), if(at2 < 0, die == 6, at2 + die <= 57)), was = at2, at[2] = if(ok, if(at2 < 0, 0, at2 + die), at2), here = if(ok, if(was < 0, mod(13*seat2, 52), if(at[2] > 50, 200 + 10*seat2 + at[2], mod(13*seat2 + at[2], 52))), -999), at[0] = if(and(and(seat0 != seat2, sq0 == here), and(here >= 0, here < 52)), -1, at0), at[1] = if(and(and(seat1 != seat2, sq1 == here), and(here >= 0, here < 52)), -2, at1), at[3] = if(and(and(seat3 != seat2, sq3 == here), and(here >= 0, here < 52)), -2, at3), at[4] = if(and(and(seat4 != seat2, sq4 == here), and(here >= 0, here < 52)), -1, at4), at[5] = if(and(and(seat5 != seat2, sq5 == here), and(here >= 0, here < 52)), -2, at5), at[6] = if(and(and(seat6 != seat2, sq6 == here), and(here >= 0, here < 52)), -1, at6), at[7] = if(and(and(seat7 != seat2, sq7 == here), and(here >= 0, here < 52)), -2, at7), turn = if(ok, if(die == 6, turn, mod(turn + 1, 4)), turn), rolled = if(ok, 0, rolled)
row on when tap 4: ok = and(and(and(seat3 == turn, rolled == 1), settled), if(at3 < 0, die == 6, at3 + die <= 57)), was = at3, at[3] = if(ok, if(at3 < 0, 0, at3 + die), at3), here = if(ok, if(was < 0, mod(13*seat3, 52), if(at[3] > 50, 200 + 10*seat3 + at[3], mod(13*seat3 + at[3], 52))), -999), at[0] = if(and(and(seat0 != seat3, sq0 == here), and(here >= 0, here < 52)), -1, at0), at[1] = if(and(and(seat1 != seat3, sq1 == here), and(here >= 0, here < 52)), -2, at1), at[2] = if(and(and(seat2 != seat3, sq2 == here), and(here >= 0, here < 52)), -1, at2), at[4] = if(and(and(seat4 != seat3, sq4 == here), and(here >= 0, here < 52)), -1, at4), at[5] = if(and(and(seat5 != seat3, sq5 == here), and(here >= 0, here < 52)), -2, at5), at[6] = if(and(and(seat6 != seat3, sq6 == here), and(here >= 0, here < 52)), -1, at6), at[7] = if(and(and(seat7 != seat3, sq7 == here), and(here >= 0, here < 52)), -2, at7), turn = if(ok, if(die == 6, turn, mod(turn + 1, 4)), turn), rolled = if(ok, 0, rolled)
