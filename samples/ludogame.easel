row on land10 = mod(13*seat10 + at10 + die, 52)
row on onto10 = if(blockade == 0, 0, or(or(or(or(or(or(or(or(or(or(or(or(or(or(or(or(or(or(0, and(sq0 == sq1, sq0 == land10)), and(sq0 == sq2, sq0 == land10)), and(sq0 == sq3, sq0 == land10)), and(sq1 == sq2, sq1 == land10)), and(sq1 == sq3, sq1 == land10)), and(sq2 == sq3, sq2 == land10)), and(sq4 == sq5, sq4 == land10)), and(sq4 == sq6, sq4 == land10)), and(sq4 == sq7, sq4 == land10)), and(sq5 == sq6, sq5 == land10)), and(sq5 == sq7, sq5 == land10)), and(sq6 == sq7, sq6 == land10)), and(sq12 == sq13, sq12 == land10)), and(sq12 == sq14, sq12 == land10)), and(sq12 == sq15, sq12 == land10)), and(sq13 == sq14, sq13 == land10)), and(sq13 == sq15, sq13 == land10)), and(sq14 == sq15, sq14 == land10)))
row on can10 = and(and(and(seat10 == turn, rolled == 1), settled), if(at10 < 0, or(die == opens, and(alsoone == 1, die == 1)), and(and(at10 + die <= 57, not(onto10)), or(or(mustcut == 0, cuts[seat10] > 0), at10 + die <= 50))))
row on land11 = mod(13*seat11 + at11 + die, 52)
row on onto11 = if(blockade == 0, 0, or(or(or(or(or(or(or(or(or(or(or(or(or(or(or(or(or(or(0, and(sq0 == sq1, sq0 == land11)), and(sq0 == sq2, sq0 == land11)), and(sq0 == sq3, sq0 == land11)), and(sq1 == sq2, sq1 == land11)), and(sq1 == sq3, sq1 == land11)), and(sq2 == sq3, sq2 == land11)), and(sq4 == sq5, sq4 == land11)), and(sq4 == sq6, sq4 == land11)), and(sq4 == sq7, sq4 == land11)), and(sq5 == sq6, sq5 == land11)), and(sq5 == sq7, sq5 == land11)), and(sq6 == sq7, sq6 == land11)), and(sq12 == sq13, sq12 == land11)), and(sq12 == sq14, sq12 == land11)), and(sq12 == sq15, sq12 == land11)), and(sq13 == sq14, sq13 == land11)), and(sq13 == sq15, sq13 == land11)), and(sq14 == sq15, sq14 == land11)))
